# Required for live OpenAI chat completions and policy embeddings.
# Replace this placeholder locally; never commit a real API key.
OPENAI_API_KEY=your-openai-api-key

# Optional chat model override. Defaults to gpt-4o-mini.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Policy embeddings currently use text-embedding-3-small in code.
# There is no embedding-model environment override at this time.
